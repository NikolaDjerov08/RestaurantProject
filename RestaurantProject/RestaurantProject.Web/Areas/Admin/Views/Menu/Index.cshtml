@model PagedResult<MenuItemServiceModel>
@{
    ViewData["Title"] = "Menu items";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1>Menu items</h1>
        <p class="text-muted-2 mb-0">@Model.TotalCount items total.</p>
    </div>
    <a class="btn btn-gold" asp-area="Admin" asp-controller="Menu" asp-action="Create">+ New item</a>
</div>

<div class="table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Available</th>
                <th style="width:1%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td class="text-muted-2">@item.CategoryName</td>
                    <td class="text-gold">$@item.Price.ToString("0.00")</td>
                    <td>
                        @if (item.IsAvailable)
                        {
                            <span class="avail-on">● Yes</span>
                        }
                        else
                        {
                            <span class="avail-off">○ No</span>
                        }
                    </td>
                    <td>
                        <div class="actions">
                            <form asp-area="Admin" asp-controller="Menu" asp-action="ToggleAvailability" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-ghost btn-xs">Toggle</button>
                            </form>
                            <a class="btn btn-outline-gold btn-xs" asp-area="Admin" asp-controller="Menu" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <form asp-area="Admin" asp-controller="Menu" asp-action="Delete" asp-route-id="@item.Id" method="post"
                                  onsubmit="return confirm('Delete this menu item?');">
                                <button type="submit" class="btn btn-danger-ghost btn-xs">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
