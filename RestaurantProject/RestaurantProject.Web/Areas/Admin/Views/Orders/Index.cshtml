@model IReadOnlyList<OrderServiceModel>
@{
    ViewData["Title"] = "Orders";
}

<h1>Orders</h1>
<p class="text-muted-2 mb-4">@Model.Count orders total.</p>

<div class="table-wrap">
    <table class="admin-table">
        <thead>
            <tr><th>#</th><th>Customer</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th><th style="width:1%;"></th></tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>#@o.Id</td>
                    <td>
                        <div>@o.UserFullName</div>
                        <div class="text-faint" style="font-size:.8rem;">@o.UserEmail</div>
                    </td>
                    <td class="text-muted-2">@o.OrderDate.ToLocalTime().ToString("MMM d, HH:mm")</td>
                    <td class="text-muted-2">@o.Items.Sum(i => i.Quantity)</td>
                    <td class="text-gold">$@o.TotalPrice.ToString("0.00")</td>
                    <td><span class="status-badge status-@o.Status">@o.Status</span></td>
                    <td><a class="btn btn-outline-gold btn-xs" asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">Manage</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
