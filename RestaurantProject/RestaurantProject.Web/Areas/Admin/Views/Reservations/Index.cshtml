@model IReadOnlyList<ReservationServiceModel>
@{
    ViewData["Title"] = "Reservations";
}

<h1>Reservations</h1>
<p class="text-muted-2 mb-4">@Model.Count reservations.</p>

<div class="table-wrap">
    <table class="admin-table">
        <thead>
            <tr><th>Customer</th><th>Date & time</th><th>Guests</th><th>Request</th><th>Status</th><th style="width:1%;">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>
                        <div>@r.UserFullName</div>
                        <div class="text-faint" style="font-size:.8rem;">@r.UserEmail</div>
                    </td>
                    <td class="text-muted-2">@r.ReservationDate.ToString("MMM d, yyyy · HH:mm")</td>
                    <td class="text-muted-2">@r.GuestsCount</td>
                    <td class="text-muted-2" style="max-width:240px;">@(string.IsNullOrWhiteSpace(r.SpecialRequest) ? "—" : r.SpecialRequest)</td>
                    <td>
                        @if (r.IsConfirmed)
                        {
                            <span class="status-badge status-Confirmed">Confirmed</span>
                        }
                        else
                        {
                            <span class="status-badge status-Pending">Pending</span>
                        }
                    </td>
                    <td>
                        <div class="actions">
                            @if (!r.IsConfirmed)
                            {
                                <form asp-area="Admin" asp-controller="Reservations" asp-action="Confirm" asp-route-id="@r.Id" method="post">
                                    <button type="submit" class="btn btn-outline-gold btn-xs">Confirm</button>
                                </form>
                            }
                            <form asp-area="Admin" asp-controller="Reservations" asp-action="Delete" asp-route-id="@r.Id" method="post"
                                  onsubmit="return confirm('Remove this reservation?');">
                                <button type="submit" class="btn btn-danger-ghost btn-xs">Remove</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
