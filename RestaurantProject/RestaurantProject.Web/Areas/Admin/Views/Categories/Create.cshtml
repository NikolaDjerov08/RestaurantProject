@model CategoryFormModel
@{
    ViewData["Title"] = "New category";
}

<h1>New category</h1>
<div class="panel p-4 p-md-5 mt-3" style="max-width:520px;">
    <form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="field-validation-error text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-gold">Create</button>
            <a class="btn btn-ghost" asp-area="Admin" asp-controller="Categories" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
