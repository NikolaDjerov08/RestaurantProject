@model UserProfileFormModel
@{
    ViewData["Title"] = "Edit profile";
}

<div class="page-head">
    <span class="gold-rule">Account</span>
    <h1>Edit profile</h1>
</div>

<div class="container-narrow pb-5">
    <div class="panel p-4 p-md-5">
        <form asp-controller="Profile" asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="field-validation-error text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="field-validation-error text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ProfileImageUrl" class="form-label"></label>
                <input asp-for="ProfileImageUrl" class="form-control" placeholder="https://..." />
                <span asp-validation-for="ProfileImageUrl" class="field-validation-error text-danger"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-gold">Save changes</button>
                <a class="btn btn-ghost" asp-controller="Profile" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
