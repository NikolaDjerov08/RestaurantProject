@{
    ViewData["Title"] = "About";
}

<div class="page-head">
    <span class="gold-rule">Our story</span>
    <h1>About Jerry's</h1>
    <p>A neighbourhood restaurant built around seasonal produce, a short considered menu, and unhurried evenings.</p>
</div>

<div class="container pb-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="panel p-4 h-100">
                <h3 class="text-gold" style="font-size:1.4rem;">Seasonal</h3>
                <p class="text-muted-2 mb-0">Our menu changes with what's good that week. Nothing sits on the pass for long.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="panel p-4 h-100">
                <h3 class="text-gold" style="font-size:1.4rem;">Considered</h3>
                <p class="text-muted-2 mb-0">A short list, done properly. Every plate earns its place.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="panel p-4 h-100">
                <h3 class="text-gold" style="font-size:1.4rem;">Warm</h3>
                <p class="text-muted-2 mb-0">Low light, good wine, and a room that's easy to linger in.</p>
            </div>
        </div>
    </div>
</div>
