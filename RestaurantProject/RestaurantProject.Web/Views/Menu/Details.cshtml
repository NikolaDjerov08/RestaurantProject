@model Restaurant.Core.Models.MenuItems.MenuItemServiceModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-5">
    <a asp-controller="Menu" asp-action="Index" class="text-muted-2" style="font-size:.9rem;">‹ Back to menu</a>

    <div class="row g-5 mt-1">
        <div class="col-lg-6">
            <div class="detail-img">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name"
                         onerror="this.style.display='none'" />
                }
            </div>
        </div>
        <div class="col-lg-6">
            <span class="cat-tag" style="position:static;display:inline-block;">@Model.CategoryName</span>
            <h1 class="mt-3" style="font-size:3rem;">@Model.Name</h1>
            <p class="text-muted-2" style="font-size:1.05rem;">@Model.Description</p>

            <div class="detail-price my-4">$@Model.Price.ToString("0.00")</div>

            <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2 align-items-end flex-wrap">
                <input type="hidden" name="menuItemId" value="@Model.Id" />
                <div>
                    <label class="form-label" for="quantity">Quantity</label>
                    <input type="number" class="form-control qty-input" id="quantity" name="quantity"
                           value="1" min="1" max="100" />
                </div>
                <button type="submit" class="btn btn-gold">Add to cart</button>
                <a class="btn btn-ghost" asp-controller="Cart" asp-action="Index">View cart</a>
            </form>
        </div>
    </div>
</div>
