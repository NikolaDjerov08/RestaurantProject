@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="text-center mb-3"><span class="gold-rule">Lumière</span></div>
        <h1>Welcome back</h1>
        <p class="auth-sub">Sign in to continue.</p>

        <form asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation-error text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation-error text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-gold w-100">Sign in</button>
        </form>

        <p class="text-center mt-3 mb-0 text-muted-2" style="font-size:.9rem;">
            New here? <a asp-controller="Account" asp-action="Register">Create an account</a>
        </p>
        <p class="text-center mt-2 mb-0 text-faint" style="font-size:.8rem;">
            Demo admin · admin@restaurant.com / Admin@@123
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
