@model IReadOnlyList<Restaurant.Core.Models.Orders.OrderServiceModel>
@{
    ViewData["Title"] = "My orders";
}

<div class="page-head">
    <span class="gold-rule">History</span>
    <h1>My orders</h1>
</div>

<div class="container-narrow pb-5" style="max-width:760px;">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="big">No orders yet</div>
            <p>When you place an order, it'll show up here.</p>
            <a class="btn btn-gold mt-2" asp-controller="Menu" asp-action="Index">Browse the menu</a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <a class="list-card d-block text-decoration-none" asp-controller="Order" asp-action="Details" asp-route-id="@order.Id">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <div style="font-family:var(--font-display);font-size:1.4rem;color:var(--text);">Order #@order.Id</div>
                        <div class="text-muted-2" style="font-size:.85rem;">@order.OrderDate.ToLocalTime().ToString("MMM d, yyyy · HH:mm") · @order.Items.Sum(i => i.Quantity) items</div>
                    </div>
                    <div class="text-end">
                        <span class="status-badge status-@order.Status">@order.Status</span>
                        <div class="text-gold mt-2" style="font-family:var(--font-display);font-size:1.3rem;">$@order.TotalPrice.ToString("0.00")</div>
                    </div>
                </div>
            </a>
        }
    }
</div>
