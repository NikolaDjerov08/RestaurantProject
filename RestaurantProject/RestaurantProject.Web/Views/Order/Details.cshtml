@model Restaurant.Core.Models.Orders.OrderServiceModel
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<div class="page-head">
    <span class="gold-rule">Order #@Model.Id</span>
    <h1>Order details</h1>
</div>

<div class="container-narrow pb-5" style="max-width:760px;">
    <div class="panel p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <div class="text-muted-2" style="font-size:.85rem;">Placed</div>
                <div>@Model.OrderDate.ToLocalTime().ToString("MMMM d, yyyy · HH:mm")</div>
            </div>
            <span class="status-badge status-@Model.Status">@Model.Status</span>
        </div>

        <hr class="divider-line" />

        @foreach (var item in Model.Items)
        {
            <div class="d-flex justify-content-between mb-2">
                <span>@item.Quantity × @item.MenuItemName <span class="text-faint">($@item.Price.ToString("0.00"))</span></span>
                <span class="text-gold">$@item.Subtotal.ToString("0.00")</span>
            </div>
        }

        <div class="cart-summary mt-4" style="background:var(--bg-elev);">
            <div class="total" style="border-top:none;margin:0;padding:0;">
                <span>Total</span><span class="amt">$@Model.TotalPrice.ToString("0.00")</span>
            </div>
        </div>

        <div class="mt-4">
            <a class="btn btn-ghost" asp-controller="Order" asp-action="Index">‹ All orders</a>
            <a class="btn btn-outline-gold" asp-controller="Menu" asp-action="Index">Order again</a>
        </div>
    </div>
</div>
